<?xml version="1.0" encoding="UTF-8"?>
<Server port="8005" shutdown="SHUTDOWN">
  <Service name="Catalina">
    <!-- Standard HTTP Connector without HTTP/2 UpgradeProtocol -->
    <Connector port="8080" protocol="HTTP/1.1" />
    <!-- Active AJP connector is present, but should NOT intercept HTTP/2 questions -->
    <Connector port="8009" protocol="AJP/1.3" secretRequired="true" secret="safe" />
  </Service>
</Server>
