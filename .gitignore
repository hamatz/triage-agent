.venv/
__pycache__/
*.pyc
.env
.DS_Store
dist/
*.egg-info/

# Dedicated output & reports directories (Recommended for all operational runs)
triage-output/
reports/

# Operational files in workspace root (Confidential Attack Map protection)
# Prefix with '/' to strictly target root directory and avoid affecting docs/ or src/
/triage_report.*
/verification_audit_report.*
/audit_signoff.*
/chain_audit_report.*
/environments.yaml
/environments.yml
/telemetry_*.json
/*triage*.json
/*triage*.md
/*audit*.json
/*audit*.md
/*report*.json
/*report*.md
/*sbom*.json
/*.cdx.json
/*.spdx.json
/output_report.md
/my_sbom.json
/test_*.json

# Whitelist safe demo/sample/example files
!sample_*
!/sample_*
!*.example.yaml
!*.example.json
