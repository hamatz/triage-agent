# Gemini API Settings
GEMINI_API_KEY="your-gemini-api-key"

# Default Model (gemini-3.5-flash is fast, stable, and widely available)
GEMINI_MODEL="gemini-3.5-flash"

# Optional Role-specific model overrides
# GEMINI_MODEL_PLANNER="gemini-2.5-pro"
# GEMINI_MODEL_RESEARCHER="gemini-2.5-flash"
# GEMINI_MODEL_TRIAGE="gemini-2.5-pro"

# GitHub Token (Optional, for higher rate limits on GitHub API)
GITHUB_TOKEN=""
